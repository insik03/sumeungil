# 숨은길 (Sumeungil) — 환경변수 템플릿
#
# 사용법: 이 파일을 복사해 .env 로 저장하고 실제 값을 채운다.
#   cp .env.example .env
# .env는 .gitignore에 이미 등록되어 있다 — 실제 키가 든 .env는 절대 커밋하지 않는다.
# 근거: 01-backend-design.md §10.4 (시크릿 관리 원칙) — 코드 리터럴 금지, 여기 ENV로만.
#
# 상태 표기: [발급완료] 실제 키를 받음 / [미발급] 아직 신청 전 / [키미확정] 어떤 값이 필요한지 자체가 미확정
# 값이 [발급완료]라도 실제 API 호출로 응답 스키마를 검증한 건 아니다 — 01-backend-design.md 4절 참고.

# ─────────────────────────────────────────────
# 1. 공공데이터 (관광콘텐츠랩 / data.go.kr)
# ─────────────────────────────────────────────
# [확인됨 2026-07-24, 마이페이지 > Open API > 인증키 발급현황 실제 화면으로 확인]
# data.go.kr 계정 1개당 "일반 인증키" 1개만 발급되고, 승인된 데이터셋 전부(제공기관이
# 한국관광공사/기상청/국가유산청으로 달라도 전부 포함) 이 키 하나로 호출한다.
# 근거: 10개 데이터셋을 승인받았는데 "인증키 발급현황" 표엔 행이 1개뿐이었다 — 데이터셋별
# 개별 키였다면 10행이 떴어야 한다. 데이터셋 상세페이지에 뜨는 "일반 인증키"도 이 키와 동일값.
#
# [발급완료 2026-07-23, 만료 2028-07-23] 아래 10개 데이터셋이 이 키로 승인되어 있다:
#   - 한국관광공사_관광지 집중률 방문자 추이 예측 정보 (D1, M2·M3·M6 핵심)
#   - 한국관광공사_지역별 관광 자원 수요 (D6-일부)
#   - 한국관광공사_지역별 관광 수요 강도 (D3)
#   - 한국관광공사_고캠핑 정보 조회서비스 (D11)
#   - 한국관광공사_무장애 여행 정보 (D11)
#   - 한국관광공사_웰니스관광정보 (D11)
#   - 한국관광공사_반려동물_동반여행_서비스 (D11)
#   - 한국관광공사_국문 관광정보 서비스 (D8 추정 — TourAPI 베이스, 실호출로 재확인 필요)
#   - 한국관광공사_관광지별 연관 관광지 정보 (D5-2, M3·M6 우회경로 후보)
#   - 국가유산청 국립무형유산원_공방 정보 목록 조회 서비스 (D17, M5 보조)
#   - 기상청_관광코스별 관광지 상세 날씨 조회서비스 (D18, M14 날씨 재정렬)
# [미발급] 아직 신청 안 한 것 — 두루누비(D4, M11 핵심), 오디오가이드(D13, M9),
#   소상공인시장진흥공단 상권정보(D7, M5 — 이건 data.go.kr이지만 제공기관이 달라
#   승인 절차가 별도이고 운영계정 전환에 1~2일 걸릴 수 있음), 전국문화축제(D9, M12)
PUBLIC_DATA_API_KEY=

# ─────────────────────────────────────────────
# 2. 지도 SDK (M4 — 지도 표시) — [정정 2026-07-24] Kakao 대신 Tmap으로 단일화 확정
# ─────────────────────────────────────────────
# 원래 Kakao Map JS SDK를 쓰려 했으나 대표가 Tmap 단일화로 최종 결정했다.
# 이유: (1) 대회 요강에 Kakao/NAVER 필수 조항 자체가 없었음(진짜 공고문 확인, 00-PRD.md 3.2절 정정 참고)
#       (2) Tmap JS SDK(Tmapv2/v3)가 마커·폴리라인·GroundOverlay(커스텀 오버레이)를 전부 지원해 기능 결손 없음
#       (3) Kakao는 "카카오맵" 제품 활성화 단계에서 막혀있었고(OPEN_MAP_AND_LOCAL 403), Tmap은 이미 검증 완료
# 아래 두 키는 더 이상 필요 없다 — 참고용으로만 남겨둔다. Kakao로 되돌릴 경우에만 채울 것.
KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=

# ─────────────────────────────────────────────
# 3. 지도 표시 + 경로 탐색 (M4 + M10 — Tmap 하나로 통합)
# ─────────────────────────────────────────────
# [발급완료, 실호출 검증됨 2026-07-24] SK Open API(openapi.sk.com)에서 발급.
# 이제 이 키 하나가 지도 SDK(M4, JS)와 경로 탐색(M10, 서버 REST)을 둘 다 담당한다.
# 필수 요건이 아니라 순수 기능·비용 판단으로 채택 — 무료 1,000건/일, 초과 시 종량 11원/건.
# 01-backend-design.md §11.2/§11.2.1/§15.3.1 참고.
# 경로 탐색(REST)은 서버에서만 호출. 단, 지도 SDK(JS)는 브라우저에 노출될 수밖에 없으므로
# Kakao와 마찬가지로 도메인 제한 설정이 있는지 Tmap 콘솔에서 확인 필요(Q-M2 갱신 대상).
TMAP_APP_KEY=

# ─────────────────────────────────────────────
# 4. AI 온보딩 (M1 — 자연어 의도 추출, LLM)
# ─────────────────────────────────────────────
# [키미확정] 02-ai-strategy.md가 LLM 채택을 권고했으나 어느 벤더인지는 미확정.
# 반드시 서버에서만 호출한다 — 프론트 번들에 포함 금지 (01-backend-design.md 시크릿 표 P4).
# 벤더의 zero-data-retention(학습 미사용) 계약 여부는 08 E4 — 대표 결정 대기, 법률 확인 필요.
LLM_API_KEY=
LLM_API_BASE_URL=

# ─────────────────────────────────────────────
# 5. 데이터베이스 / 캐시
# ─────────────────────────────────────────────
# PostgreSQL 16 + PostGIS 3 (01-backend-design.md §5)
DATABASE_URL=postgresql://user:password@localhost:5432/sumeungil

# Redis — 혼잡도 캐시, 로드밸런싱 카운터, 게스트 세션 (§8, §15.1.5 등)
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# 6. 인증 / 시크릿
# ─────────────────────────────────────────────
# JWT 서명키 — 32바이트 이상 랜덤값. "secret" 같은 기본값 금지 (§10.4).
#   생성 예: openssl rand -hex 32
JWT_SECRET_KEY=

# M6 로드밸런싱 dedupe에서 user_id/guest_id를 해싱할 때 쓰는 서버 전용 키.
# 원본 식별자를 Redis 키에 그대로 넣지 않기 위한 HMAC 시크릿 (§8.2.1 D1).
COUNTER_HMAC_KEY=

# ─────────────────────────────────────────────
# 7. 오브젝트 스토리지 (M8 — 방문 인증 사진, 7일 TTL)
# ─────────────────────────────────────────────
# S3 호환 스토리지 아무거나(AWS S3 / Cloudflare R2 / Ncloud Object Storage 등).
# 원본 바이너리는 DB에 넣지 않고 참조만 저장한다 (§15.1.4). 버킷은 비공개(ACL)로 설정할 것 —
# 06-security-report.md S-M12가 지적한 미확정 항목이니 실제 설정 시 반드시 비공개로 만들 것.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

# ─────────────────────────────────────────────
# 8. 애플리케이션 설정
# ─────────────────────────────────────────────
APP_ENV=development
# 필수 ENV 미설정 시 부팅 즉시 종료(fail-fast) 원칙 — §10.4. 기본값으로 몰래 뜨지 않는다.
