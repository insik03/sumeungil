# 숨은길 backend 환경변수 예시. 실제 값은 .env 에 넣는다(.env 는 커밋 금지).
# backend/.env 가 없으면 앱은 상위 projects/sumeungil/.env 를 자동으로 참조한다.

# [필수] 공공데이터포털 일반 인증키. 없으면 부팅 즉시 종료(fail-fast).
PUBLIC_DATA_API_KEY=

# ---------------------------------------------------------------------------
# [필수] PostgreSQL — 리뷰·공유코스·로그인 계정·온보딩 취향 프로필·AI 코스 저장소.
# 2026-08-17 SQLite에서 전환(db/postgres.py). 비어 있으면 부팅은 되지만 이 기능들만
# 비활성화된다(조회 위주 기능은 정상 동작 — "저장소 장애로 부팅을 막지 않는다" 원칙).
# 로컬 개발용 컨테이너 1개를 아래처럼 띄우고 접속 문자열을 그대로 쓰면 된다:
#   docker run --name sumeungil-postgres-dev -e POSTGRES_DB=sumeungil \
#     -e POSTGRES_USER=sumeungil -e POSTGRES_PASSWORD=<임의비밀번호> \
#     -p 5433:5432 -v sumeungil-postgres-dev-data:/var/lib/postgresql/data \
#     -d postgres:16-alpine
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://sumeungil:<임의비밀번호>@localhost:5433/sumeungil

# [선택] 데모 기본 지역 — 미설정 시 부산 해운대구(26/26350)로 동작(실데이터 확인됨).
DEFAULT_AREA_CD=26
DEFAULT_SIGUNGU_CD=26350

# [선택] 캐시 TTL(초). 기본 600(10분).
CACHE_TTL_SEC=600

# [선택] 한적한 날 예보 캐시 TTL(초). 기본 21600(6시간, 계약 부록 M.5 근거).
# 원천이 '날짜 단위 예측치'라 하루 안에 바뀌지 않고, 전량 페이징(최대 3콜)이라 짧은 TTL 은 쿼터 낭비다.
FORECAST_CACHE_TTL_SEC=21600

# [선택] 원천 API 타임아웃(초). 기본 8.
UPSTREAM_TIMEOUT_SEC=8

# [선택] 날씨(기상청 D18) — 부록 Q 신설분.
# WEATHER_TIMEOUT_SEC        : 추천 rerank 경로(사용자가 목록을 기다림). 기본 6.
# WEATHER_SLOW_TIMEOUT_SEC   : 9권역 보드 / 출발일 전망 전용. 캐시가 길어 한 번 잘 받는 편이 낫다. 기본 12.
# WEATHER_BOARD_BLOCK_BUDGET_SEC : 보드에서 권역 1곳이 끌 수 있는 최대 시간(초). 기본 20.
WEATHER_TIMEOUT_SEC=6
WEATHER_SLOW_TIMEOUT_SEC=12
WEATHER_BOARD_BLOCK_BUDGET_SEC=20

# [선택] CORS 허용 오리진(콤마 구분). 기본 http://localhost:3000
CORS_ORIGINS=http://localhost:3000

APP_ENV=development

# [선택] 로컬 AI(Ollama). Qwen3.5 4B Q4는 로컬 품질 우선 기본값이며,
# scripts/benchmark_local_llms.py로 기존 모델과 같은 관광 질의를 비교할 수 있다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_TEMPERATURE=0
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_SEC=30

# [선택] 코스 AI 요약(courses/arrange·recommend 응답의 ai_summary, 부록 I.11).
# 로컬 Ollama 재사용 — 새 키·비용 없음. 끄면 ai_summary 는 항상 null(코스는 정상 동작).
COURSE_SUMMARY_ENABLED=true
COURSE_SUMMARY_TIMEOUT_SEC=20
COURSE_SUMMARY_MAX_CHARS=1200
COURSE_SUMMARY_CACHE_TTL_SEC=86400

# ---------------------------------------------------------------------------
# [선택] 공유 코스 좋아요 (부록 R.14, 2026-08-20) — 하트는 로그인 필수.
# 미설정이면 아래 기본값 그대로 동작한다(config.py). 커뮤니티/팁 쪽 나머지 키
# (COMMUNITY_ENABLED · SHARE_* · TIPS_*)는 backend/.env.production.example 참고.
# ---------------------------------------------------------------------------
# 좋아요 전용 킬스위치. false 면 POST/DELETE /api/v1/courses/shared/{code}/like 가
# 503 FEATURE_DISABLED 로 닫힌다(피드·상세의 like_count·liked_by_me 는 계속 내려간다).
LIKE_ENABLED=true
# 여기만 device_id 가 아니라 **계정(user_id) 기준** 분당 쓰기 상한이다.
LIKE_WRITE_PER_MIN=30

# ---------------------------------------------------------------------------
# [선택] 레이트 리미팅 (부록 O) — IP 기준 인메모리 슬라이딩 윈도우.
# **로컬 기본값은 false** 다. 켜지 않으면 이 기능 도입 전과 동작이 100% 동일하다.
# 공개 배포(Oracle VM)에서는 반드시 true 로 켠다 → backend/.env.production.example 참고.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=false
# 아래 값들은 RATE_LIMIT_ENABLED=true 일 때만 의미가 있다.
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_LLM_PER_MIN=6        # POST /api/v1/onboarding/analyze · /api/v1/tips/personalized
RATE_LIMIT_COURSE_PER_MIN=10    # POST /api/v1/courses/*
RATE_LIMIT_DEFAULT_PER_MIN=120  # 그 외 전부 (0 이하 = 해당 버킷 제한 해제)
RATE_LIMIT_TRUST_PROXY=true     # X-Forwarded-For 첫 값 사용. nginx 뒤일 때만 true.
RATE_LIMIT_MAX_KEYS=20000

# ---------------------------------------------------------------------------
# [선택] 관리자(운영) 콘솔 — 부록 T
# 비워두면 관리자 기능이 **아예 없다**(/api/v1/admin/* 404, OpenAPI 미노출).
# 값은 평문이 아니라 scrypt 해시다:  py scripts/make_admin_hash.py  로 생성한다.
# 로컬 개발에서는 보통 비워둔 채로 두고, 관리자 화면을 만질 때만 임시 해시를 넣는다.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD_HASH=
# 세션 쿠키 Secure 속성. https 가 아니면 브라우저가 쿠키를 저장하지 않으므로
# 로컬(http://localhost)에서 관리자 화면을 개발할 때는 false 가 필요하다.
ADMIN_COOKIE_SECURE=false
# 세션 만료(초). 기본 8시간.
ADMIN_SESSION_TTL_SEC=28800
# 로그인 시도 상한(IP 기준, 분당). RATE_LIMIT_ENABLED 와 무관하게 항상 동작한다.
ADMIN_LOGIN_PER_MIN=5
# [선택] 세션 서명 키. 미설정이면 JWT_SECRET_KEY → 그것도 없으면 비밀번호 해시에서 파생한다.
ADMIN_SESSION_SECRET=
# [선택] 프론트(:3000)와 백엔드(:8000)를 따로 띄워 관리자 화면을 개발할 때만 true.
# 배포는 nginx 뒤 동일 오리진이라 false 로 둔다. CORS_ORIGINS 에 * 가 있으면 무시된다.
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# [선택] 구글 로그인 (2026-08-17, 데모 닉네임 로그인 완전 대체)
# GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI 중 하나라도 비어 있으면 그 provider만
# 개별적으로 404(아래 카카오와 독립 — 한쪽만 설정해도 나머지 한쪽은 정상 동작).
# 세션 서명 키(USER_SESSION_SECRET, 더 아래)가 없으면 관리자 콘솔과 동일한 원칙으로
# /api/v1/auth/* 라우터 자체가 통째로 등록되지 않는다.
# ---------------------------------------------------------------------------
# console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
# 만들기(웹 애플리케이션)에서 발급. 로컬 개발용과 운영(sumeungil.co.kr)용을 별도
# 클라이언트로 만들기를 권장한다 — 승인된 리디렉션 URI가 정확히 일치해야 하기 때문.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 위 클라이언트의 "승인된 리디렉션 URI"와 문자 그대로 일치해야 한다.
# 로컬: http://localhost:8000/api/v1/auth/google/callback
# 운영: https://sumeungil.co.kr/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# [선택] 카카오 로그인 (2026-08-17, 대표 지시 — 구글 옆에 간편로그인으로 추가)
# 위 구글과 완전히 같은 원칙: 셋 다 있어야 카카오 라우트가 활성화된다. 같은
# 이메일로 구글·카카오를 둘 다 쓰면 자동 계정 통합되지만, 카카오 쪽 이메일이
# "검증됨" 상태일 때만 통합된다(repositories/user_repo.py 모듈 docstring 참고).
# ---------------------------------------------------------------------------
# developers.kakao.com → 내 애플리케이션 → 애플리케이션 추가 → 앱 설정 > 요약 정보에서
# REST API 키(=CLIENT_ID) 확인. 제품 설정 > 카카오 로그인 > 보안에서 Client Secret 발급
# 후 켜기(선택이지만 권장). **제품 설정 > 카카오 로그인 > 동의항목**에서 "닉네임"은
# "선택 동의", "카카오계정(이메일)"은 "필수 동의"로 켜야 한다(이메일을 선택으로 두면
# 대부분 사용자가 체크 해제해 계정 통합 로직이 사실상 무력화된다) — scope로 요청해도
# 콘솔에서 켜지 않은 항목은 응답에 아예 안 온다(deploy/DEPLOY.md 카카오 절 참고).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔의 "Redirect URI"와 문자 그대로 일치해야 한다.
# 로컬: http://localhost:8000/api/v1/auth/kakao/callback
# 운영: https://sumeungil.co.kr/api/v1/auth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback

# 로그인 팝업이 postMessage 를 보낼 대상 오리진(=프론트 주소, 구글·카카오 공용). 로컬: http://localhost:3000
# 운영: https://sumeungil.co.kr — 와일드카드(*) 금지, CORS_ORIGINS 와 동일한 이유로
# 위조 오리진에 세션 정보가 새는 것을 막는 유일한 방어선이다.
FRONTEND_BASE_URL=http://localhost:3000
# [필수, 비워두면 안 됨] 사용자 세션 토큰 서명 키. 미설정이면 JWT_SECRET_KEY 로
# 대체되지만 그것마저 없으면 세션이 위조 가능해지므로(2026-08-17 보안검토 C-1)
# GOOGLE_CLIENT_ID 등이 설정돼 있어도 라우터가 켜지지 않는다. 아래로 생성:
#   py -c "import secrets; print(secrets.token_hex(32))"
USER_SESSION_SECRET=
# 세션 쿠키 Secure 속성. https 가 아니면 브라우저가 쿠키를 저장하지 않으므로
# 로컬(http://localhost)에서는 false, 운영(https)에서는 반드시 true.
USER_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# [선택] 슬랙 5xx 에러 알림 (2026-08-18, 대표 지시 — #알림-봇)
# ---------------------------------------------------------------------------
# 비워두면 알림 미들웨어를 아예 등록하지 않는다(로컬 개발 기본값). 값이 있으면
# 500 응답·미처리 예외가 발생할 때 슬랙 #알림-봇 으로 경로·예외·트레이스백을 보낸다.
#
# 발급: slack.com/apps → 앱 생성 → Incoming Webhooks 켜기 → #알림-봇 선택
#       (절차는 deploy/SLACK-ALERTS.md 참고)
# ⚠️ 이 URL 은 **비밀번호와 같다** — 아는 사람은 누구나 우리 채널에 글을 쓸 수 있다.
#    커밋 금지, 슬랙·이슈에 붙여넣기 금지. GitHub Actions 는 저장소 Secrets 에 넣는다.
SLACK_WEBHOOK_URL=
# 같은 (경로, 예외) 조합을 몇 초 동안 1회만 알릴지. 기본 600초(10분).
# 원천 장애 한 건에 5xx 가 초당 수십 건 터지므로 이 창을 0 으로 두지 말 것.
SLACK_ALERT_DEDUP_WINDOW_SEC=600
# 아침 운영 요약 시각(KST, 0~23). -1 이면 끈다. 로컬에서는 웹훅이 없으면 애초에 안 돈다.
SLACK_DAILY_SUMMARY_HOUR=9
# 슬래시 명령어 서명 검증 키(운영에서만 필요). 비우면 /api/v1/slack/* 가 등록되지 않는다.
SLACK_SIGNING_SECRET=
