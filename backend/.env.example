# 숨은길 backend 환경변수 예시. 실제 값은 .env 에 넣는다(.env 는 커밋 금지).
# backend/.env 가 없으면 앱은 상위 projects/sumeungil/.env 를 자동으로 참조한다.

# [필수] 공공데이터포털 일반 인증키. 없으면 부팅 즉시 종료(fail-fast).
PUBLIC_DATA_API_KEY=

# [선택] 데모 기본 지역 — 미설정 시 부산 해운대구(26/26350)로 동작(실데이터 확인됨).
DEFAULT_AREA_CD=26
DEFAULT_SIGUNGU_CD=26350

# [선택] 캐시 TTL(초). 기본 600(10분).
CACHE_TTL_SEC=600

# [선택] 한적한 날 예보 캐시 TTL(초). 기본 21600(6시간, 계약 부록 M.5 근거).
# 원천이 '날짜 단위 예측치'라 하루 안에 바뀌지 않고, 전량 페이징(최대 3콜)이라 짧은 TTL 은 쿼터 낭비다.
FORECAST_CACHE_TTL_SEC=21600

# [선택] 원천 API 타임아웃(초). 기본 8.
UPSTREAM_TIMEOUT_SEC=8

# [선택] 날씨(기상청 D18) — 부록 Q 신설분.
# WEATHER_TIMEOUT_SEC        : 추천 rerank 경로(사용자가 목록을 기다림). 기본 6.
# WEATHER_SLOW_TIMEOUT_SEC   : 9권역 보드 / 출발일 전망 전용. 캐시가 길어 한 번 잘 받는 편이 낫다. 기본 12.
# WEATHER_BOARD_BLOCK_BUDGET_SEC : 보드에서 권역 1곳이 끌 수 있는 최대 시간(초). 기본 20.
WEATHER_TIMEOUT_SEC=6
WEATHER_SLOW_TIMEOUT_SEC=12
WEATHER_BOARD_BLOCK_BUDGET_SEC=20

# [선택] CORS 허용 오리진(콤마 구분). 기본 http://localhost:3000
CORS_ORIGINS=http://localhost:3000

APP_ENV=development

# [선택] 코스 AI 요약(courses/arrange·recommend 응답의 ai_summary, 부록 I.11).
# 로컬 Ollama 재사용 — 새 키·비용 없음. 끄면 ai_summary 는 항상 null(코스는 정상 동작).
COURSE_SUMMARY_ENABLED=true
COURSE_SUMMARY_TIMEOUT_SEC=20
COURSE_SUMMARY_MAX_CHARS=1200
COURSE_SUMMARY_CACHE_TTL_SEC=86400

# ---------------------------------------------------------------------------
# [선택] 레이트 리미팅 (부록 O) — IP 기준 인메모리 슬라이딩 윈도우.
# **로컬 기본값은 false** 다. 켜지 않으면 이 기능 도입 전과 동작이 100% 동일하다.
# 공개 배포(Oracle VM)에서는 반드시 true 로 켠다 → backend/.env.production.example 참고.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=false
# 아래 값들은 RATE_LIMIT_ENABLED=true 일 때만 의미가 있다.
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_LLM_PER_MIN=6        # POST /api/v1/concierge/ask · /api/v1/onboarding/analyze
RATE_LIMIT_COURSE_PER_MIN=10    # POST /api/v1/courses/*
RATE_LIMIT_DEFAULT_PER_MIN=120  # 그 외 전부 (0 이하 = 해당 버킷 제한 해제)
RATE_LIMIT_TRUST_PROXY=true     # X-Forwarded-For 첫 값 사용. nginx 뒤일 때만 true.
RATE_LIMIT_MAX_KEYS=20000

# ---------------------------------------------------------------------------
# [선택] 관리자(운영) 콘솔 — 부록 T
# 비워두면 관리자 기능이 **아예 없다**(/api/v1/admin/* 404, OpenAPI 미노출).
# 값은 평문이 아니라 scrypt 해시다:  py scripts/make_admin_hash.py  로 생성한다.
# 로컬 개발에서는 보통 비워둔 채로 두고, 관리자 화면을 만질 때만 임시 해시를 넣는다.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD_HASH=
# 세션 쿠키 Secure 속성. https 가 아니면 브라우저가 쿠키를 저장하지 않으므로
# 로컬(http://localhost)에서 관리자 화면을 개발할 때는 false 가 필요하다.
ADMIN_COOKIE_SECURE=false
# 세션 만료(초). 기본 8시간.
ADMIN_SESSION_TTL_SEC=28800
# 로그인 시도 상한(IP 기준, 분당). RATE_LIMIT_ENABLED 와 무관하게 항상 동작한다.
ADMIN_LOGIN_PER_MIN=5
# [선택] 세션 서명 키. 미설정이면 JWT_SECRET_KEY → 그것도 없으면 비밀번호 해시에서 파생한다.
ADMIN_SESSION_SECRET=
# [선택] 프론트(:3000)와 백엔드(:8000)를 따로 띄워 관리자 화면을 개발할 때만 true.
# 배포는 nginx 뒤 동일 오리진이라 false 로 둔다. CORS_ORIGINS 에 * 가 있으면 무시된다.
CORS_ALLOW_CREDENTIALS=false
